# ═══════════════════════════════════════════════════════════════════════════════
# CoderNest Portal — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env.local` for local development.
# In Vercel production: add ALL variables marked [REQUIRED] to the Vercel
# dashboard → Project Settings → Environment Variables.
#
# Legend:
#   [REQUIRED] App will crash or behave incorrectly without this.
#   [OPTIONAL] Feature degrades gracefully if missing.
#   [AUTO]     Set automatically by Vercel — do not add manually.
# ═══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# DATABASE  [REQUIRED]
# Primary MongoDB connection string used by Prisma ORM.
# Get this from MongoDB Atlas → Connect → Drivers.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.sample.mongodb.net/codernest?retryWrites=true&w=majority"

# Legacy Mongoose direct connection (used by webhooks/lead route).
# Should match the same cluster as DATABASE_URL.
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.sample.mongodb.net/codernest"


# ─────────────────────────────────────────────────────────────────────────────
# NEXTAUTH  [REQUIRED]
# ─────────────────────────────────────────────────────────────────────────────
# Random 32-char secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-nextauth-random-string-here"

# Must be your exact production URL (no trailing slash).
# Vercel sets VERCEL_URL automatically, but NextAuth needs the explicit canonical URL.
NEXTAUTH_URL="https://codernest.agency"


# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH  [OPTIONAL — required if Google Sign-In is enabled]
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI must include: https://codernest.agency/api/auth/callback/google
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id-here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"


# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE ANALYTICS & SEARCH CONSOLE  [OPTIONAL]
# Used by analytics.actions.ts to pull GA4 data into the admin dashboard.
# ─────────────────────────────────────────────────────────────────────────────
# GA4 Property ID from GA Admin → Property → Property details (format: 123456789)
GA4_PROPERTY_ID="123456789"

# Google Service Account credentials for server-side GA4 Data API access.
# Create at Google Cloud Console → IAM → Service Accounts → Keys → JSON.
GOOGLE_SERVICE_ACCOUNT_EMAIL="codernest-analytics@your-project.iam.gserviceaccount.com"
# The private_key field from the JSON key file. Keep the literal \n newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSAMPLE_KEY\n-----END PRIVATE KEY-----\n"


# ─────────────────────────────────────────────────────────────────────────────
# STRIPE  [REQUIRED if payment features are active]
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your_stripe_publishable_key_here"


# ─────────────────────────────────────────────────────────────────────────────
# RESEND (Transactional Email)  [REQUIRED]
# Used to send contact form confirmations, lead notifications, and invoices.
# Get API key from resend.com → API Keys.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY="your_resend_api_key_here"

# Fallback SMTP (Nodemailer). Only needed if Resend is unavailable.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="noreply@codernest.agency"
SMTP_PASS="your-smtp-app-password"


# ─────────────────────────────────────────────────────────────────────────────
# OPENAI  [OPTIONAL — required for AI Chatbot and fetch-project features]
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY="your_openai_api_key_here"


# ─────────────────────────────────────────────────────────────────────────────
# N8N AUTOMATION  [OPTIONAL]
# Used by the lead webhook route to push new leads into n8n workflows.
# ─────────────────────────────────────────────────────────────────────────────
N8N_API_URL="https://your-n8n-instance.com/api/v1"
N8N_API_KEY="your-n8n-api-key"


# ─────────────────────────────────────────────────────────────────────────────
# WHATSAPP BUSINESS API  [OPTIONAL]
# Used for WhatsApp notification integrations.
# ─────────────────────────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN="your_whatsapp_access_token_here"
WHATSAPP_PHONE_NUMBER_ID="1234567890"


# ─────────────────────────────────────────────────────────────────────────────
# INTERNAL API KEYS  [REQUIRED if external lead ingestion is active]
# ─────────────────────────────────────────────────────────────────────────────
# Bearer token for POST /api/leads (external CRM → CoderNest ingestion)
LEADS_API_KEY="cn_leads_your_strong_random_secret_here"

# Bearer token for internal webhook endpoints
WEBHOOK_SECRET="cn_webhook_your_strong_random_secret_here"


# ─────────────────────────────────────────────────────────────────────────────
# META / FACEBOOK  [OPTIONAL — required for pixel tracking]
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FACEBOOK_PIXEL_ID="1234567890123456"


# ─────────────────────────────────────────────────────────────────────────────
# APP CONFIG  [REQUIRED]
# ─────────────────────────────────────────────────────────────────────────────
# The canonical public URL of the app. Used in emails and metadata.
NEXT_PUBLIC_APP_URL="https://codernest.agency"

# Node environment — Vercel sets this automatically.
NODE_ENV="production"


# ─────────────────────────────────────────────────────────────────────────────
# UPSTASH REDIS & RATE LIMITING  [REQUIRED FOR DISTRIBUTED EDGE RATE LIMITING]
# Sign up at https://console.upstash.com → Create Database → REST API
# Used by src/lib/ratelimit.ts & Next.js Proxy Middleware for Edge DDoS / Bot protection.
# ─────────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"


# ─────────────────────────────────────────────────────────────────────────────
# UPSTASH QSTASH & WORKFLOWS  [REQUIRED FOR BACKGROUND EMAILS & ONBOARDING WORKFLOWS]
# Sign up at https://console.upstash.com → QStash
# Used by src/lib/qstash.ts, /api/qstash/send-email, and /api/workflows/onboarding.
# ─────────────────────────────────────────────────────────────────────────────
# QStash REST token for queuing background jobs & workflow execution
QSTASH_TOKEN="your_qstash_token_here"

# QStash signing keys for verifying cryptographic signatures on inbound worker callbacks
QSTASH_CURRENT_SIGNING_KEY="your_qstash_current_signing_key_here"
# Optional secondary key for zero-downtime key rotation
QSTASH_NEXT_SIGNING_KEY="your_qstash_next_signing_key_here"

# Optional base URL override when running locally with ngrok, localtunnel, or custom domain
# Example: https://abc1234.ngrok-free.app
QSTASH_NEXT_URL=""


# ═══════════════════════════════════════════════════════════════════════════════
# VERCEL CHECKLIST — paste ALL of the above into:
#   Vercel Dashboard → Your Project → Settings → Environment Variables
#
# Critical ones that MUST be set or the app will 500 on boot:
#   ✅ DATABASE_URL
#   ✅ MONGODB_URI
#   ✅ NEXTAUTH_SECRET
#   ✅ NEXTAUTH_URL
#   ✅ RESEND_API_KEY
#   ✅ NEXT_PUBLIC_APP_URL
#   ✅ STRIPE_SECRET_KEY (if payments active)
#   ✅ STRIPE_WEBHOOK_SECRET (if webhook active)
#   ✅ UPSTASH_REDIS_REST_URL (for Edge Rate Limiting)
#   ✅ UPSTASH_REDIS_REST_TOKEN (for Edge Rate Limiting)
#   ✅ QSTASH_TOKEN (for Background Email Queuing & Workflows)
#   ✅ QSTASH_CURRENT_SIGNING_KEY (for Secure Inbound Signature Verification)
# ═══════════════════════════════════════════════════════════════════════════════
