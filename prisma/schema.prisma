generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  freeCredits   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  blogs         Blog[]
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application Models

enum Role {
  SUPER_ADMIN
  EMPLOYEE
  USER
}

model Blog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  cover_image String?
  imageUrl    String?
  tags        String[]
  status      String   @default("draft") // draft or published
  authorId    String   @db.ObjectId
  metaTitle   String?
  metaDesc    String?
  keywords    String?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Lead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  company   String?
  message   String?
  budget    String?
  status    String   @default("new")
  source           String   @default("Main B2B Agency")
  serviceRequested String?
  
  hasNewReply      Boolean  @default(false)
  lastReplySnippet String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  emailLogs        EmailTrackingLog[]
}

model CaseStudy {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  sector      String
  clientName  String?
  challenge   String
  solution    String
  results     String?
  techStack   String[]
  marketingPixels Json?
  imageUrl    String?
  githubUrl   String?
  liveDemoUrl String?
  featured    Boolean  @default(false)
  metaTitle   String?
  metaDesc    String?
  keywords    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServicePricing {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  sector        String
  tier          String
  price         Int
  priceLabel    String?
  features      String[]
  ctaLabel      String
  stripePriceId String?
  isPopular     Boolean  @default(false)
  customHtml    String?
  displayOrder  Int      @default(0)
  
  // Dynamic Pricing Fields
  baseMonthlyPrice     Float?
  baseYearlyPrice      Float?
  hourlyLimit          Int?
  marketRateMultiplier Float    @default(1.0)
  featureToggles       Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Testimonial {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  client_name         String
  designation_company String?
  review_text         String
  rating              Int
  avatar_url          String?
  is_published        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PortfolioImage {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  original_image_url  String
  processed_image_url String?
  status              String   @default("completed")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SystemSettings {
  id                  String   @id @default("global_settings") @map("_id")
  // Branding
  siteName            String   @default("CoderNest")
  siteTitle           String   @default("Elite B2B software agency")
  logoUrl             String?
  faviconUrl          String?
  brandColor          String   @default("#3B82F6")
  secondaryColor      String   @default("#00F2FE")
  
  // Contact
  address             String?
  primaryEmail        String?
  supportEmail        String?
  phone               String?
  
  // SMTP
  smtpHost            String?
  smtpPort            Int?
  smtpUser            String?
  smtpPassword        String?
  
  // Integrations
  googleAnalyticsId   String?
  facebookPixelId     String?
  customHeaderScripts String?
  customFooterScripts String?
  
  // Alert Gateway Credentials
  telegramBotToken    String?
  whatsappAccessToken String?
  whatsappPhoneId     String?
  twilioAccountSid    String?
  twilioAuthToken     String?
  twilioPhoneNumber   String?
  
  // Automation
  n8nWebhookUrl       String?
  
  // Company Stats
  foundedYear         String   @default("2023")
  totalClients        Int      @default(50)
  totalProjects       Int      @default(120)

  updatedAt           DateTime @updatedAt
}

model TeamMember {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  designation String
  department  String
  bio         String?
  imageUrl    String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  subject   String
  html_body String
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId    String   @db.ObjectId
  title       String
  type        String
  status      String   @default("pending")
  milestones  Json?
  live_link   String?
  marketingPixels Json?
  techStack       String[]
  createdAt   DateTime @default(now())
  completedAt DateTime?
}

model ImageOrder {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId     String   @db.ObjectId
  clientEmail  String?
  tier         String
  status       String   @default("pending")
  originalUrl  String
  processedUrl String?
  instructions String?
  createdAt    DateTime @default(now())
  completedAt  DateTime?
}

model Invoice {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId          String?  @db.ObjectId
  clientName        String?
  clientEmail       String?
  clientPhone       String?
  clientAddress     String?
  clientType        String?  @default("Local")
  amount            Int
  currency          String   @default("USD")
  status            String   @default("draft")
  invoiceNumber     String?
  description       String?
  items             Json?
  dueDate           DateTime?
  paymentMethod     String?
  stripeSessionId   String?
  stripePaymentLink String?
  paypalLink        String?
  escrowLink        String?
  invoiceHtml       String?
  invoicePdfUrl     String?
  createdAt         DateTime @default(now())
  paidAt            DateTime?
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  senderId  String   @db.ObjectId
  text      String
  createdAt DateTime @default(now())
}

model Media {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  altText   String?
  createdAt DateTime @default(now())
}

model DynamicPage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  title       String
  htmlContent String?
  cssContent  String?
  jsContent   String?
  isPublished Boolean  @default(false)
  metaTitle   String?
  metaDesc    String?
  keywords    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Visitor {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String     @unique
  ipAddress String?
  location  String?
  companyName String?
  companyDomain String?
  domain      String?
  isISP       Boolean @default(false)
  companyData Json?
  isIdentified Boolean @default(false)
  isBot        Boolean @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  pageViews PageView[]
}

model PageView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  visitorId String   @db.ObjectId
  url       String
  timeSpent Int      @default(0) // Time in seconds
  createdAt DateTime @default(now())
  
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
}

enum EmailStatus {
  SENT
  OPENED
  CLICKED
  BOUNCED
}

model Campaign {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  subject      String
  totalSent    Int                @default(0)
  totalOpened  Int                @default(0)
  totalClicked Int                @default(0)
  createdAt    DateTime           @default(now())
  logs         EmailTrackingLog[]
}

model EmailTrackingLog {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String      @db.ObjectId
  leadId     String      @db.ObjectId
  status     EmailStatus @default(SENT)
  openedAt   DateTime?
  clickedAt  DateTime?
  createdAt  DateTime    @default(now())

  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// ── Photo Editing Services & Pricing Models (ClippingBD Engine) ─────────────

model PhotoService {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String   // e.g., "Clipping Path", "Multi Layer Clipping"
  slug        String   @unique
  description String
  iconName    String?  // Lucide icon name or image URL
  imageUrl    String?
  features    String[] // Bullet points of features
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ServiceCategory {
  PHOTO_EDITING
  SOFTWARE_DEV
  CUSTOM
}

enum PricingModelType {
  UNIT_BASED    // Pay-per-image, Hourly rate, Day rate
  FIXED_PACKAGE // Monthly retainer, Fixed milestone, Tiered bundle
}

model PricingPlan {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  category        ServiceCategory  @default(SOFTWARE_DEV)
  modelType       PricingModelType @default(FIXED_PACKAGE)
  
  title           String           // e.g. "Clipping Path" or "Dedicated Node.js Contractor"
  name            String?          // Backward compatible alias
  priceDisplay    String           // e.g. "$0.20", "$40", "$5,000"
  unitLabel       String           @default("/month") // e.g. "/per image", "/hour", "/month", "/project"
  unit            String?          @default("/per image") // Backward compatible alias
  
  badge           String?          // e.g. "Most Popular", "Best Value"
  isPopular       Boolean          @default(false)
  
  description     String?
  features        String[]         // Bullet points
  minQuantity     Int?             // For unit-based (e.g. min 50 images or min 10 hrs)
  
  ctaText         String           @default("Get Started")
  ctaAction       String           @default("contact") // "checkout", "contact", "whatsapp"
  ctaLink         String?          @default("#contact")
  
  order           Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}


model BeforeAfterShowcase {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String   // e.g., "Jewelry Clipping", "Apparel Retouching"
  category    String   // e.g., "Clipping Path", "Color Correction"
  beforeImage String   // Original photo URL
  afterImage  String   // Edited/clipped photo URL
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ChannelPlatform {
  SMS
  WHATSAPP
  TELEGRAM
}

model AlertChannel {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  platform     ChannelPlatform
  identifier   String          // Phone number (e.g., +8801...) or Telegram Chat ID
  label        String?         // e.g., "Personal Mobile", "Ops WhatsApp"
  
  isVerified   Boolean         @default(false)
  isActive     Boolean         @default(false)
  
  otpHash      String?         // Encrypted/Hashed 6-digit OTP
  otpExpiresAt DateTime?
  
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([platform, identifier])
}

// ── Executive Financial Dashboard ────────────────────────────────────────────

enum TransactionType {
  SOFTWARE_CONTRACT
  PHOTO_EDITING
  ADSENSE_PAYOUT
  CUSTOM
}

enum ExpenseCategory {
  GOOGLE_ADS
  META_ADS
  INFRASTRUCTURE
  OUTREACH_TOOLS
}

model RevenueRecord {
  id         String          @id @default(cuid()) @map("_id")
  title      String
  clientName String?
  amount     Float
  type       TransactionType @default(SOFTWARE_CONTRACT)
  status     String          @default("PAID") // "PAID" | "PENDING" | "REFUNDED"
  receivedAt DateTime        @default(now())
  notes      String?
  createdAt  DateTime        @default(now())
}

model MarketingExpense {
  id          String          @id @default(cuid()) @map("_id")
  campaign    String
  category    ExpenseCategory @default(GOOGLE_ADS)
  amountSpent Float
  clicks      Int?            @default(0)
  impressions Int?            @default(0)
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
}

enum PlatformType {
  GITHUB
  LINKEDIN
  TWITTER_X
  UPWORK
  FIVERR
  YOUTUBE
  FACEBOOK
  DISCORD
  CUSTOM
}

model SocialLink {
  id        String       @id @default(cuid()) @map("_id")
  platform  PlatformType @default(CUSTOM)
  label     String       
  url       String       
  order     Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}
